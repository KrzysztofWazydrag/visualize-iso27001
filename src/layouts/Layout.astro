---
import "../styles/global.css";
interface Props {
  title?: string;
}
const { title = "Visualize ISO 27001 — The ISMS engine room" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Explore ISO 27001 as one connected system. Follow risks, controls, evidence and improvement through an interactive ISMS engine room."
    />
    <meta name="theme-color" content="#101315" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
